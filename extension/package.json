{
  "name": "git-jungle-agents",
  "displayName": "Git Jungle: Agent Status",
  "description": "Shows which git worktrees have a Claude Code agent running or waiting for input",
  "version": "0.0.1",
  "publisher": "ftnilsson",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "scm": [
        {
          "id": "gitJungle.worktrees",
          "name": "Worktree Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "gitJungle.refresh",
        "title": "Git Jungle: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitJungle.openInNewWindow",
        "title": "Open Worktree in New Window",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "gitJungle.openTerminal",
        "title": "Open Terminal in Worktree",
        "icon": "$(terminal)"
      },
      {
        "command": "gitJungle.installHooks",
        "title": "Git Jungle: Install Claude Code Hooks"
      },
      {
        "command": "gitJungle.showView",
        "title": "Git Jungle: Show Worktree Agents"
      },
      {
        "command": "gitJungle.row.claude",
        "title": "Claude is working",
        "icon": {
          "light": "media/claude-pulse.svg",
          "dark": "media/claude-pulse.svg"
        }
      },
      {
        "command": "gitJungle.row.copilot",
        "title": "Copilot is working",
        "icon": {
          "light": "media/copilot-pulse.svg",
          "dark": "media/copilot-pulse.svg"
        }
      },
      {
        "command": "gitJungle.row.codex",
        "title": "Codex is working",
        "icon": {
          "light": "media/codex-pulse.svg",
          "dark": "media/codex-pulse.svg"
        }
      },
      {
        "command": "gitJungle.row.other",
        "title": "Agent is working",
        "icon": "$(sync~spin)"
      },
      {
        "command": "gitJungle.row.waiting",
        "title": "Agent needs your input",
        "icon": "$(bell-dot)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitJungle.refresh",
          "when": "view == gitJungle.worktrees",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitJungle.openInNewWindow",
          "when": "view == gitJungle.worktrees",
          "group": "inline@1"
        },
        {
          "command": "gitJungle.openTerminal",
          "when": "view == gitJungle.worktrees",
          "group": "inline@2"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "gitJungle.row.waiting",
          "group": "inline@0",
          "when": "scmProviderRootUri in gitJungle.waiting"
        },
        {
          "command": "gitJungle.row.claude",
          "group": "inline@0",
          "when": "scmProviderRootUri in gitJungle.running.claude"
        },
        {
          "command": "gitJungle.row.copilot",
          "group": "inline@0",
          "when": "scmProviderRootUri in gitJungle.running.copilot"
        },
        {
          "command": "gitJungle.row.codex",
          "group": "inline@0",
          "when": "scmProviderRootUri in gitJungle.running.codex"
        },
        {
          "command": "gitJungle.row.other",
          "group": "inline@0",
          "when": "scmProviderRootUri in gitJungle.running.other"
        }
      ],
      "commandPalette": [
        {
          "command": "gitJungle.row.claude",
          "when": "false"
        },
        {
          "command": "gitJungle.row.copilot",
          "when": "false"
        },
        {
          "command": "gitJungle.row.codex",
          "when": "false"
        },
        {
          "command": "gitJungle.row.other",
          "when": "false"
        },
        {
          "command": "gitJungle.row.waiting",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Git Jungle",
      "properties": {
        "gitJungle.resetToIdleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Show a worktree as idle when its agent has sent no status event for this many minutes (covers closed or crashed sessions). A single tool call that runs longer than this shows as idle until the next event."
        }
      }
    }
  },
  "license": "MIT",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "worktree",
    "claude",
    "agent"
  ]
}
