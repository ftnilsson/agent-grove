{
  "name": "agent-grove",
  "displayName": "Agent Grove: Worktree Status for AI Coding Agents",
  "description": "See which git worktree has an AI coding agent (Claude Code, Copilot CLI, Codex) working, waiting for you, or idle - right in the Source Control sidebar.",
  "version": "0.1.0",
  "publisher": "ftnilsson",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "scm": [
        {
          "id": "agentGrove.worktrees",
          "name": "Worktree Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "agentGrove.refresh",
        "title": "Agent Grove: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentGrove.openInNewWindow",
        "title": "Open Worktree in New Window",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "agentGrove.openTerminal",
        "title": "Open Terminal in Worktree",
        "icon": "$(terminal)"
      },
      {
        "command": "agentGrove.installHooks",
        "title": "Agent Grove: Install Agent Hooks"
      },
      {
        "command": "agentGrove.showView",
        "title": "Agent Grove: Show Worktree Agents"
      },
      {
        "command": "agentGrove.row.claude",
        "title": "Claude is working",
        "icon": {
          "light": "media/claude-pulse.svg",
          "dark": "media/claude-pulse.svg"
        }
      },
      {
        "command": "agentGrove.row.copilot",
        "title": "Copilot is working",
        "icon": {
          "light": "media/copilot-pulse.svg",
          "dark": "media/copilot-pulse.svg"
        }
      },
      {
        "command": "agentGrove.row.codex",
        "title": "Codex is working",
        "icon": {
          "light": "media/codex-pulse.svg",
          "dark": "media/codex-pulse.svg"
        }
      },
      {
        "command": "agentGrove.row.other",
        "title": "Agent is working",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agentGrove.row.waiting",
        "title": "Agent needs your input",
        "icon": "$(bell-dot)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentGrove.refresh",
          "when": "view == agentGrove.worktrees",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentGrove.openInNewWindow",
          "when": "view == agentGrove.worktrees",
          "group": "inline@1"
        },
        {
          "command": "agentGrove.openTerminal",
          "when": "view == agentGrove.worktrees",
          "group": "inline@2"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "agentGrove.row.waiting",
          "group": "inline@0",
          "when": "scmProviderRootUri in agentGrove.waiting"
        },
        {
          "command": "agentGrove.row.claude",
          "group": "inline@0",
          "when": "scmProviderRootUri in agentGrove.running.claude"
        },
        {
          "command": "agentGrove.row.copilot",
          "group": "inline@0",
          "when": "scmProviderRootUri in agentGrove.running.copilot"
        },
        {
          "command": "agentGrove.row.codex",
          "group": "inline@0",
          "when": "scmProviderRootUri in agentGrove.running.codex"
        },
        {
          "command": "agentGrove.row.other",
          "group": "inline@0",
          "when": "scmProviderRootUri in agentGrove.running.other"
        }
      ],
      "commandPalette": [
        {
          "command": "agentGrove.row.claude",
          "when": "false"
        },
        {
          "command": "agentGrove.row.copilot",
          "when": "false"
        },
        {
          "command": "agentGrove.row.codex",
          "when": "false"
        },
        {
          "command": "agentGrove.row.other",
          "when": "false"
        },
        {
          "command": "agentGrove.row.waiting",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent Grove",
      "properties": {
        "agentGrove.hideAfterMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Remove the agent indicator from a worktree when its agent has sent no status event for this many minutes (covers closed or crashed sessions). A single tool call that runs longer than this loses its indicator until the next event."
        }
      }
    }
  },
  "license": "MIT",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "worktree",
    "claude",
    "copilot",
    "codex",
    "ai",
    "agent",
    "status"
  ]
}
